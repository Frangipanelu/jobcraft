# JobCraft 环境变量示例
# 复制为 .env 后按实际密钥调整，不要提交真实密钥

# CORS 配置（允许的前端域名，逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# JWT 配置（生产环境必须修改）
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_EXPIRE_MINUTES=10080

# LLM 配置 (智谱 AI OpenAI 兼容端点)
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENAI_API_KEY=your_zhipu_api_key
LLM_model=glm-4-flash
# LLM 请求超时（秒），防止挂起请求长期占用上游并发槽
LLM_REQUEST_TIMEOUT=180
# LLM 进程级限流（智谱免费档约 1 req/s、低并发，错误码 1302/HTTP 429）
# 注意：backend 与 worker 各自独立限流，合计仍受账户全局速率约束
LLM_RATE_LIMIT_RPS=1.0
LLM_CONCURRENCY_LIMIT=1
LLM_RATE_LIMIT_RETRIES=3
LLM_RATE_LIMIT_BACKOFF_BASE=1.0

# Tavily 配置（面试准备公司调研用）
TAVILY_API_KEY=your_tavily_api_key

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=jobcraft
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_ECHO=false
