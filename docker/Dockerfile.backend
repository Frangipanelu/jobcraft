# JobCraft Backend Dockerfile
# 使用 uv 管理 Python 依赖

FROM docker.1ms.run/library/python:3.12-slim AS base

# uv 依赖下载镜像（容器内默认 PyPI 连通性不稳定，改用清华 TUNA 简单源）
ENV UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple/
ENV UV_HTTP_TIMEOUT=300
ENV UV_HTTP_RETRIES=5
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# 安装 uv（通过 pip 安装，统一走清华源）
RUN pip install --no-cache-dir uv

WORKDIR /app

# 复制依赖文件（利用 Docker 缓存层）
COPY pyproject.toml uv.lock ./

# 安装依赖（不含开发依赖）
RUN uv sync --frozen --no-dev --no-install-project 2>&1 | tail -5

# 复制应用代码 + prompt 模板
COPY app/ ./app/
COPY prompts/ ./prompts/

# 安装项目本身
RUN uv sync --frozen --no-dev 2>&1 | tail -5

# 创建输出目录
RUN mkdir -p output updated

EXPOSE 8000

CMD ["uv", "run", "--no-sync", "uvicorn", "app.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
